<Window x:Class="NeatShot.Editor.EditorWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:editor="clr-namespace:NeatShot.Editor"
        mc:Ignorable="d"
        d:DataContext="{d:DesignInstance editor:EditorViewModel}"
        Title="NeatShot"
        Width="1100"
        Height="760"
        MinWidth="720"
        MinHeight="480"
        WindowStartupLocation="CenterScreen"
        Background="#1B1B20">
  <Window.Resources>
    <editor:ToolToBoolConverter x:Key="ToolToBool" />
    <editor:RgbaToBrushConverter x:Key="RgbaToBrush" />
    <editor:EqualityConverter x:Key="Equality" />

    <Style x:Key="ToolButton" TargetType="RadioButton">
      <Setter Property="Focusable" Value="False" />
      <Setter Property="Width" Value="40" />
      <Setter Property="Height" Value="36" />
      <Setter Property="Margin" Value="2,0" />
      <Setter Property="Cursor" Value="Hand" />
      <Setter Property="Foreground" Value="#E8E8EC" />
      <Setter Property="FontFamily" Value="Segoe Fluent Icons, Segoe MDL2 Assets, Segoe UI Symbol" />
      <Setter Property="FontSize" Value="16" />
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="RadioButton">
            <Border x:Name="Chrome" Background="Transparent" CornerRadius="6">
              <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="Chrome" Property="Background" Value="#22FFFFFF" />
              </Trigger>
              <Trigger Property="IsChecked" Value="True">
                <Setter TargetName="Chrome" Property="Background" Value="#0A84FF" />
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <Style x:Key="IconButton" TargetType="Button">
      <Setter Property="Focusable" Value="False" />
      <Setter Property="Width" Value="40" />
      <Setter Property="Height" Value="36" />
      <Setter Property="Margin" Value="2,0" />
      <Setter Property="Cursor" Value="Hand" />
      <Setter Property="Foreground" Value="#E8E8EC" />
      <Setter Property="FontFamily" Value="Segoe Fluent Icons, Segoe MDL2 Assets, Segoe UI Symbol" />
      <Setter Property="FontSize" Value="16" />
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Button">
            <Border x:Name="Chrome" Background="Transparent" CornerRadius="6">
              <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="Chrome" Property="Background" Value="#22FFFFFF" />
              </Trigger>
              <Trigger Property="IsEnabled" Value="False">
                <Setter Property="Foreground" Value="#55E8E8EC" />
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <Style x:Key="Swatch" TargetType="RadioButton">
      <Setter Property="Focusable" Value="False" />
      <Setter Property="Width" Value="22" />
      <Setter Property="Height" Value="22" />
      <Setter Property="Margin" Value="2,0" />
      <Setter Property="Cursor" Value="Hand" />
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="RadioButton">
            <Grid>
              <Ellipse x:Name="Ring" Stroke="Transparent" StrokeThickness="2" Margin="0" />
              <Ellipse Fill="{Binding Converter={StaticResource RgbaToBrush}}" Margin="4" />
            </Grid>
            <ControlTemplate.Triggers>
              <Trigger Property="IsChecked" Value="True">
                <Setter TargetName="Ring" Property="Stroke" Value="#E8E8EC" />
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <Style x:Key="Separator" TargetType="Rectangle">
      <Setter Property="Width" Value="1" />
      <Setter Property="Height" Value="22" />
      <Setter Property="Margin" Value="8,0" />
      <Setter Property="Fill" Value="#33FFFFFF" />
    </Style>
  </Window.Resources>

  <DockPanel>
    <Border DockPanel.Dock="Top" Background="#232329" Padding="10,6" BorderBrush="#33000000" BorderThickness="0,0,0,1">
      <DockPanel LastChildFill="False">
        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
          <RadioButton Style="{StaticResource ToolButton}" ToolTip="Select (V)" Content="&#xE7C9;"
                       IsChecked="{Binding ActiveTool, Converter={StaticResource ToolToBool}, ConverterParameter={x:Static editor:EditorTool.Select}}" />
          <RadioButton Style="{StaticResource ToolButton}" ToolTip="Arrow (A)" Content="&#xE72A;"
                       IsChecked="{Binding ActiveTool, Converter={StaticResource ToolToBool}, ConverterParameter={x:Static editor:EditorTool.Arrow}}" />
          <RadioButton Style="{StaticResource ToolButton}" ToolTip="Rectangle (R)" Content="&#xE739;"
                       IsChecked="{Binding ActiveTool, Converter={StaticResource ToolToBool}, ConverterParameter={x:Static editor:EditorTool.Rectangle}}" />
          <RadioButton Style="{StaticResource ToolButton}" ToolTip="Ellipse (O)" Content="&#xEA3A;"
                       IsChecked="{Binding ActiveTool, Converter={StaticResource ToolToBool}, ConverterParameter={x:Static editor:EditorTool.Ellipse}}" />
          <RadioButton Style="{StaticResource ToolButton}" ToolTip="Pen (P)" Content="&#xE70F;"
                       IsChecked="{Binding ActiveTool, Converter={StaticResource ToolToBool}, ConverterParameter={x:Static editor:EditorTool.Freehand}}" />
          <RadioButton Style="{StaticResource ToolButton}" ToolTip="Text (T)" Content="&#xE8D2;"
                       IsChecked="{Binding ActiveTool, Converter={StaticResource ToolToBool}, ConverterParameter={x:Static editor:EditorTool.Text}}" />
          <RadioButton Style="{StaticResource ToolButton}" ToolTip="Counter (N)" Content="&#xE8EF;"
                       IsChecked="{Binding ActiveTool, Converter={StaticResource ToolToBool}, ConverterParameter={x:Static editor:EditorTool.Counter}}" />
          <RadioButton Style="{StaticResource ToolButton}" ToolTip="Highlight (H)" Content="&#xE7E6;"
                       IsChecked="{Binding ActiveTool, Converter={StaticResource ToolToBool}, ConverterParameter={x:Static editor:EditorTool.Highlight}}" />
          <RadioButton Style="{StaticResource ToolButton}" ToolTip="Blur (B)" Content="&#xE9A9;"
                       IsChecked="{Binding ActiveTool, Converter={StaticResource ToolToBool}, ConverterParameter={x:Static editor:EditorTool.Blur}}" />
          <RadioButton Style="{StaticResource ToolButton}" ToolTip="Pixelate" Content="&#xE80A;"
                       IsChecked="{Binding ActiveTool, Converter={StaticResource ToolToBool}, ConverterParameter={x:Static editor:EditorTool.Pixelate}}" />

          <Rectangle Style="{StaticResource Separator}" />

          <ItemsControl ItemsSource="{Binding Palette}" VerticalAlignment="Center">
            <ItemsControl.ItemsPanel>
              <ItemsPanelTemplate>
                <StackPanel Orientation="Horizontal" />
              </ItemsPanelTemplate>
            </ItemsControl.ItemsPanel>
            <ItemsControl.ItemTemplate>
              <DataTemplate>
                <RadioButton Style="{StaticResource Swatch}" GroupName="Palette"
                             Command="{Binding DataContext.SelectColorCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                             CommandParameter="{Binding}">
                  <RadioButton.IsChecked>
                    <MultiBinding Converter="{StaticResource Equality}" Mode="OneWay">
                      <Binding />
                      <Binding Path="DataContext.Color" RelativeSource="{RelativeSource AncestorType=Window}" />
                    </MultiBinding>
                  </RadioButton.IsChecked>
                </RadioButton>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>

          <Rectangle Style="{StaticResource Separator}" />

          <ItemsControl ItemsSource="{Binding StrokeWidths}" VerticalAlignment="Center">
            <ItemsControl.ItemsPanel>
              <ItemsPanelTemplate>
                <StackPanel Orientation="Horizontal" />
              </ItemsPanelTemplate>
            </ItemsControl.ItemsPanel>
            <ItemsControl.ItemTemplate>
              <DataTemplate>
                <RadioButton Style="{StaticResource ToolButton}" Width="30" GroupName="Stroke"
                             Command="{Binding DataContext.SelectStrokeWidthCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                             CommandParameter="{Binding}">
                  <RadioButton.IsChecked>
                    <MultiBinding Converter="{StaticResource Equality}" Mode="OneWay">
                      <Binding />
                      <Binding Path="DataContext.StrokeWidth" RelativeSource="{RelativeSource AncestorType=Window}" />
                    </MultiBinding>
                  </RadioButton.IsChecked>
                  <Ellipse Fill="#E8E8EC" Width="{Binding}" Height="{Binding}" />
                </RadioButton>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
        </StackPanel>

        <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
          <Button Style="{StaticResource IconButton}" ToolTip="Undo (Ctrl+Z)" Content="&#xE7A7;" Command="{Binding UndoCommand}" />
          <Button Style="{StaticResource IconButton}" ToolTip="Redo (Ctrl+Y)" Content="&#xE7A6;" Command="{Binding RedoCommand}" />
          <Rectangle Style="{StaticResource Separator}" />
          <Button Style="{StaticResource IconButton}" ToolTip="Copy (Ctrl+C)" Content="&#xE8C8;" Command="{Binding CopyCommand}" />
          <Button Style="{StaticResource IconButton}" ToolTip="Save (Ctrl+S)" Content="&#xE74E;" Command="{Binding SaveCommand}" />
          <Button Style="{StaticResource IconButton}" ToolTip="Save as (Ctrl+Shift+S)" Content="&#xE792;" Command="{Binding SaveAsCommand}" />
        </StackPanel>
      </DockPanel>
    </Border>

    <Border DockPanel.Dock="Bottom" Background="#232329" Padding="12,4" BorderBrush="#33000000" BorderThickness="0,1,0,0">
      <TextBlock Foreground="#9A9AA3" FontSize="12" Text="{Binding StatusMessage}" />
    </Border>

    <Grid Margin="12">
      <editor:EditorCanvas x:Name="Surface" ViewModel="{Binding}" Focusable="True">
        <editor:EditorCanvas.InputBindings>
          <KeyBinding Modifiers="Ctrl" Key="Z" Command="{Binding UndoCommand}" />
          <KeyBinding Modifiers="Ctrl" Key="Y" Command="{Binding RedoCommand}" />
          <KeyBinding Modifiers="Ctrl+Shift" Key="Z" Command="{Binding RedoCommand}" />
          <KeyBinding Modifiers="Ctrl" Key="C" Command="{Binding CopyCommand}" />
          <KeyBinding Modifiers="Ctrl" Key="S" Command="{Binding SaveCommand}" />
          <KeyBinding Modifiers="Ctrl+Shift" Key="S" Command="{Binding SaveAsCommand}" />
          <KeyBinding Key="Delete" Command="{Binding DeleteSelectionCommand}" />
          <KeyBinding Key="V" Command="{Binding SelectToolCommand}" CommandParameter="{x:Static editor:EditorTool.Select}" />
          <KeyBinding Key="A" Command="{Binding SelectToolCommand}" CommandParameter="{x:Static editor:EditorTool.Arrow}" />
          <KeyBinding Key="R" Command="{Binding SelectToolCommand}" CommandParameter="{x:Static editor:EditorTool.Rectangle}" />
          <KeyBinding Key="O" Command="{Binding SelectToolCommand}" CommandParameter="{x:Static editor:EditorTool.Ellipse}" />
          <KeyBinding Key="P" Command="{Binding SelectToolCommand}" CommandParameter="{x:Static editor:EditorTool.Freehand}" />
          <KeyBinding Key="T" Command="{Binding SelectToolCommand}" CommandParameter="{x:Static editor:EditorTool.Text}" />
          <KeyBinding Key="N" Command="{Binding SelectToolCommand}" CommandParameter="{x:Static editor:EditorTool.Counter}" />
          <KeyBinding Key="H" Command="{Binding SelectToolCommand}" CommandParameter="{x:Static editor:EditorTool.Highlight}" />
          <KeyBinding Key="B" Command="{Binding SelectToolCommand}" CommandParameter="{x:Static editor:EditorTool.Blur}" />
        </editor:EditorCanvas.InputBindings>
      </editor:EditorCanvas>
      <Canvas x:Name="TextLayer" IsHitTestVisible="False">
        <TextBox x:Name="TextEntry"
                 Visibility="Collapsed"
                 IsHitTestVisible="True"
                 MinWidth="80"
                 Background="#CC1B1B20"
                 Foreground="#E8E8EC"
                 BorderBrush="#0A84FF"
                 FontFamily="Segoe UI"
                 FontWeight="SemiBold"
                 AcceptsReturn="False" />
      </Canvas>
    </Grid>
  </DockPanel>
</Window>
