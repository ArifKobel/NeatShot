<Window x:Class="NeatShot.Editor.EditorWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:editor="clr-namespace:NeatShot.Editor"
        xmlns:icons="clr-namespace:NeatShot.Icons"
        mc:Ignorable="d"
        d:DataContext="{d:DesignInstance editor:EditorViewModel}"
        Title="NeatShot"
        Width="1180"
        Height="800"
        MinWidth="760"
        MinHeight="520"
        WindowStartupLocation="CenterScreen"
        FontFamily="Segoe UI Variable Text, Segoe UI"
        Background="{StaticResource ChromeBrush}"
        UseLayoutRounding="True">
  <Window.Resources>
    <editor:ToolToBoolConverter x:Key="ToolToBool" />
    <editor:RgbaToBrushConverter x:Key="RgbaToBrush" />
    <editor:EqualityConverter x:Key="Equality" />
    <editor:PercentConverter x:Key="Percent" />
    <BooleanToVisibilityConverter x:Key="BoolToVisibility" />

    <Style x:Key="ToolButton" TargetType="RadioButton">
      <Setter Property="Focusable" Value="False" />
      <Setter Property="Width" Value="30" />
      <Setter Property="Height" Value="28" />
      <Setter Property="Margin" Value="1,0" />
      <Setter Property="Cursor" Value="Hand" />
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="RadioButton">
            <Border x:Name="Chrome" Background="Transparent" CornerRadius="6">
              <icons:Icon x:Name="Glyph" Data="{TemplateBinding Content}" Stroke="{StaticResource TextBrush}" HorizontalAlignment="Center" VerticalAlignment="Center" />
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="Chrome" Property="Background" Value="{StaticResource HoverBrush}" />
              </Trigger>
              <Trigger Property="IsChecked" Value="True">
                <Setter TargetName="Chrome" Property="Background" Value="{StaticResource AccentBrush}" />
                <Setter TargetName="Glyph" Property="Stroke" Value="White" />
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <Style x:Key="IconButton" TargetType="Button">
      <Setter Property="Focusable" Value="False" />
      <Setter Property="Width" Value="30" />
      <Setter Property="Height" Value="28" />
      <Setter Property="Margin" Value="1,0" />
      <Setter Property="Cursor" Value="Hand" />
      <Setter Property="Foreground" Value="{StaticResource TextBrush}" />
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Button">
            <Border x:Name="Chrome" Background="Transparent" CornerRadius="6">
              <icons:Icon Data="{TemplateBinding Content}" Stroke="{TemplateBinding Foreground}" HorizontalAlignment="Center" VerticalAlignment="Center" />
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="Chrome" Property="Background" Value="{StaticResource HoverBrush}" />
              </Trigger>
              <Trigger Property="IsEnabled" Value="False">
                <Setter Property="Foreground" Value="{StaticResource DisabledBrush}" />
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <Style x:Key="PopoverButton" TargetType="ToggleButton">
      <Setter Property="Focusable" Value="False" />
      <Setter Property="Width" Value="30" />
      <Setter Property="Height" Value="28" />
      <Setter Property="Margin" Value="1,0" />
      <Setter Property="Cursor" Value="Hand" />
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="ToggleButton">
            <Border x:Name="Chrome" Background="Transparent" CornerRadius="6">
              <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="Chrome" Property="Background" Value="{StaticResource HoverBrush}" />
              </Trigger>
              <Trigger Property="IsChecked" Value="True">
                <Setter TargetName="Chrome" Property="Background" Value="{StaticResource ActiveBrush}" />
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
      <Style.Triggers>
        <Trigger Property="IsChecked" Value="True">
          <Setter Property="IsHitTestVisible" Value="False" />
        </Trigger>
      </Style.Triggers>
    </Style>

    <Style x:Key="Swatch" TargetType="RadioButton">
      <Setter Property="Focusable" Value="False" />
      <Setter Property="Width" Value="28" />
      <Setter Property="Height" Value="28" />
      <Setter Property="Cursor" Value="Hand" />
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="RadioButton">
            <Grid>
              <Ellipse x:Name="Ring" Stroke="Transparent" StrokeThickness="2" Margin="1" />
              <Ellipse Fill="{Binding Converter={StaticResource RgbaToBrush}}" Stroke="#33FFFFFF" StrokeThickness="1" Margin="6" />
            </Grid>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="Ring" Property="Stroke" Value="{StaticResource DividerBrush}" />
              </Trigger>
              <Trigger Property="IsChecked" Value="True">
                <Setter TargetName="Ring" Property="Stroke" Value="{StaticResource TextBrush}" />
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <Style x:Key="SizeButton" TargetType="RadioButton">
      <Setter Property="Focusable" Value="False" />
      <Setter Property="Width" Value="32" />
      <Setter Property="Height" Value="32" />
      <Setter Property="Cursor" Value="Hand" />
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="RadioButton">
            <Border x:Name="Chrome" Background="Transparent" CornerRadius="6">
              <Ellipse x:Name="Dot" Fill="{StaticResource MutedBrush}" Width="{Binding}" Height="{Binding}" />
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="Chrome" Property="Background" Value="{StaticResource HoverBrush}" />
                <Setter TargetName="Dot" Property="Fill" Value="{StaticResource TextBrush}" />
              </Trigger>
              <Trigger Property="IsChecked" Value="True">
                <Setter TargetName="Chrome" Property="Background" Value="{StaticResource ActiveBrush}" />
                <Setter TargetName="Dot" Property="Fill" Value="{StaticResource AccentBrush}" />
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <Style x:Key="Popover" TargetType="Border">
      <Setter Property="Background" Value="{StaticResource PopoverBrush}" />
      <Setter Property="BorderBrush" Value="{StaticResource DividerBrush}" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="CornerRadius" Value="10" />
      <Setter Property="Padding" Value="8" />
      <Setter Property="Margin" Value="12" />
      <Setter Property="Effect">
        <Setter.Value>
          <DropShadowEffect BlurRadius="18" ShadowDepth="4" Opacity="0.45" />
        </Setter.Value>
      </Setter>
    </Style>

    <Style x:Key="Divider" TargetType="Rectangle">
      <Setter Property="Width" Value="1" />
      <Setter Property="Height" Value="14" />
      <Setter Property="Margin" Value="6,0" />
      <Setter Property="Fill" Value="{StaticResource DividerBrush}" />
    </Style>

    <Style x:Key="StatusText" TargetType="TextBlock">
      <Setter Property="Foreground" Value="{StaticResource MutedBrush}" />
      <Setter Property="FontSize" Value="12" />
      <Setter Property="VerticalAlignment" Value="Center" />
    </Style>

    <ContextMenu x:Key="CanvasMenu">
      <MenuItem Header="Delete" InputGestureText="Del" Command="{Binding DeleteSelectionCommand}" />
      <MenuItem Header="Duplicate" InputGestureText="Ctrl+D" Command="{Binding DuplicateCommand}" />
      <Separator />
      <MenuItem Header="Bring to front" Command="{Binding BringToFrontCommand}" />
      <MenuItem Header="Send to back" Command="{Binding SendToBackCommand}" />
      <Separator />
      <MenuItem Header="Select all" InputGestureText="Ctrl+A" Command="{Binding SelectAllCommand}" />
      <Separator />
      <MenuItem Header="Copy image" InputGestureText="Ctrl+C" Command="{Binding CopyCommand}" />
      <MenuItem Header="Save" InputGestureText="Ctrl+S" Command="{Binding SaveCommand}" />
    </ContextMenu>
  </Window.Resources>

  <DockPanel>
    <Border DockPanel.Dock="Top" Background="{StaticResource ChromeBrush}" Padding="10,6" BorderBrush="{StaticResource EdgeBrush}" BorderThickness="0,0,0,1">
      <Grid>
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="*" />
          <ColumnDefinition Width="Auto" />
          <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
          <Button Style="{StaticResource IconButton}" ToolTip="Undo (Ctrl+Z)" Content="{StaticResource IconUndo}" Command="{Binding UndoCommand}" />
          <Button Style="{StaticResource IconButton}" ToolTip="Redo (Ctrl+Y)" Content="{StaticResource IconRedo}" Command="{Binding RedoCommand}" />
        </StackPanel>

        <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
          <Border Background="{StaticResource WellBrush}" CornerRadius="8" Padding="3">
            <StackPanel Orientation="Horizontal">
              <RadioButton Style="{StaticResource ToolButton}" ToolTip="Select (V)" Content="{StaticResource IconMousePointer}"
                           IsChecked="{Binding ActiveTool, Converter={StaticResource ToolToBool}, ConverterParameter={x:Static editor:EditorTool.Select}}" />
              <RadioButton Style="{StaticResource ToolButton}" ToolTip="Rectangle (R)" Content="{StaticResource IconSquare}"
                           IsChecked="{Binding ActiveTool, Converter={StaticResource ToolToBool}, ConverterParameter={x:Static editor:EditorTool.Rectangle}}" />
              <RadioButton Style="{StaticResource ToolButton}" ToolTip="Ellipse (O)" Content="{StaticResource IconCircle}"
                           IsChecked="{Binding ActiveTool, Converter={StaticResource ToolToBool}, ConverterParameter={x:Static editor:EditorTool.Ellipse}}" />
              <RadioButton Style="{StaticResource ToolButton}" ToolTip="Pen (P)" Content="{StaticResource IconPencil}"
                           IsChecked="{Binding ActiveTool, Converter={StaticResource ToolToBool}, ConverterParameter={x:Static editor:EditorTool.Freehand}}" />
              <RadioButton Style="{StaticResource ToolButton}" ToolTip="Arrow (A)" Content="{StaticResource IconArrowUpRight}"
                           IsChecked="{Binding ActiveTool, Converter={StaticResource ToolToBool}, ConverterParameter={x:Static editor:EditorTool.Arrow}}" />
              <RadioButton Style="{StaticResource ToolButton}" ToolTip="Text (T)" Content="{StaticResource IconType}"
                           IsChecked="{Binding ActiveTool, Converter={StaticResource ToolToBool}, ConverterParameter={x:Static editor:EditorTool.Text}}" />
              <RadioButton Style="{StaticResource ToolButton}" ToolTip="Blur (B)" Content="{StaticResource IconDroplet}"
                           IsChecked="{Binding ActiveTool, Converter={StaticResource ToolToBool}, ConverterParameter={x:Static editor:EditorTool.Blur}}" />
              <RadioButton Style="{StaticResource ToolButton}" ToolTip="Pixelate" Content="{StaticResource IconGrid}"
                           IsChecked="{Binding ActiveTool, Converter={StaticResource ToolToBool}, ConverterParameter={x:Static editor:EditorTool.Pixelate}}" />
              <RadioButton Style="{StaticResource ToolButton}" ToolTip="Counter (N)" Content="{StaticResource IconCounter}"
                           IsChecked="{Binding ActiveTool, Converter={StaticResource ToolToBool}, ConverterParameter={x:Static editor:EditorTool.Counter}}" />
              <RadioButton Style="{StaticResource ToolButton}" ToolTip="Highlight (H)" Content="{StaticResource IconHighlighter}"
                           IsChecked="{Binding ActiveTool, Converter={StaticResource ToolToBool}, ConverterParameter={x:Static editor:EditorTool.Highlight}}" />
            </StackPanel>
          </Border>

          <ToggleButton x:Name="ColorButton" Style="{StaticResource PopoverButton}" Margin="10,0,0,0" ToolTip="Color">
            <Ellipse Width="14" Height="14" Fill="{Binding Color, Converter={StaticResource RgbaToBrush}}" Stroke="#40FFFFFF" StrokeThickness="1" />
          </ToggleButton>
          <Popup PlacementTarget="{Binding ElementName=ColorButton}" Placement="Bottom" HorizontalOffset="-12" VerticalOffset="-8"
                 IsOpen="{Binding IsChecked, ElementName=ColorButton, Mode=TwoWay}" StaysOpen="False" AllowsTransparency="True" PopupAnimation="Fade">
            <Border Style="{StaticResource Popover}">
              <ItemsControl ItemsSource="{Binding Palette}">
                <ItemsControl.ItemsPanel>
                  <ItemsPanelTemplate>
                    <UniformGrid Columns="4" />
                  </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                  <DataTemplate>
                    <RadioButton Style="{StaticResource Swatch}" GroupName="Palette"
                                 Command="{Binding DataContext.SelectColorCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                 CommandParameter="{Binding}">
                      <RadioButton.IsChecked>
                        <MultiBinding Converter="{StaticResource Equality}" Mode="OneWay">
                          <Binding />
                          <Binding Path="DataContext.Color" RelativeSource="{RelativeSource AncestorType=Window}" />
                        </MultiBinding>
                      </RadioButton.IsChecked>
                    </RadioButton>
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>
            </Border>
          </Popup>

          <ToggleButton x:Name="SizeButton" Style="{StaticResource PopoverButton}" ToolTip="Line width">
            <icons:Icon Data="{StaticResource IconMinus}" Stroke="{StaticResource TextBrush}" StrokeThickness="{Binding StrokeWidth}" />
          </ToggleButton>
          <Popup PlacementTarget="{Binding ElementName=SizeButton}" Placement="Bottom" HorizontalOffset="-12" VerticalOffset="-8"
                 IsOpen="{Binding IsChecked, ElementName=SizeButton, Mode=TwoWay}" StaysOpen="False" AllowsTransparency="True" PopupAnimation="Fade">
            <Border Style="{StaticResource Popover}">
              <ItemsControl ItemsSource="{Binding StrokeWidths}">
                <ItemsControl.ItemsPanel>
                  <ItemsPanelTemplate>
                    <StackPanel Orientation="Horizontal" />
                  </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                  <DataTemplate>
                    <RadioButton Style="{StaticResource SizeButton}" GroupName="Stroke"
                                 Command="{Binding DataContext.SelectStrokeWidthCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                 CommandParameter="{Binding}">
                      <RadioButton.IsChecked>
                        <MultiBinding Converter="{StaticResource Equality}" Mode="OneWay">
                          <Binding />
                          <Binding Path="DataContext.StrokeWidth" RelativeSource="{RelativeSource AncestorType=Window}" />
                        </MultiBinding>
                      </RadioButton.IsChecked>
                    </RadioButton>
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>
            </Border>
          </Popup>

          <ToggleButton x:Name="StrengthButton" Style="{StaticResource PopoverButton}" ToolTip="Intensity"
                        Visibility="{Binding ShowsObscureStrength, Converter={StaticResource BoolToVisibility}}">
            <icons:Icon Data="{StaticResource IconSliders}" Stroke="{StaticResource TextBrush}" />
          </ToggleButton>
          <Popup PlacementTarget="{Binding ElementName=StrengthButton}" Placement="Bottom" HorizontalOffset="-12" VerticalOffset="-8"
                 IsOpen="{Binding IsChecked, ElementName=StrengthButton, Mode=TwoWay}" StaysOpen="False" AllowsTransparency="True" PopupAnimation="Fade">
            <Border Style="{StaticResource Popover}" Padding="12,10">
              <StackPanel Orientation="Horizontal">
                <TextBlock Text="Intensity" Foreground="{StaticResource MutedBrush}" FontSize="12" VerticalAlignment="Center" Margin="0,0,10,0" />
                <Slider Width="140" Minimum="1" Maximum="10" TickFrequency="1" IsSnapToTickEnabled="True" VerticalAlignment="Center"
                        Value="{Binding ObscureStrength, Mode=TwoWay}" />
                <TextBlock Text="{Binding ObscureStrength}" Foreground="{StaticResource TextBrush}" FontSize="12" Width="18" TextAlignment="Right" VerticalAlignment="Center" />
              </StackPanel>
            </Border>
          </Popup>
        </StackPanel>

        <StackPanel Grid.Column="2" Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
          <Button Style="{StaticResource IconButton}" ToolTip="Copy (Ctrl+C)" Content="{StaticResource IconCopy}" Command="{Binding CopyCommand}" />
          <Button Style="{StaticResource IconButton}" ToolTip="Save as (Ctrl+Shift+S)" Content="{StaticResource IconFolderOpen}" Command="{Binding SaveAsCommand}" />
          <Button Style="{StaticResource IconButton}" ToolTip="Save (Ctrl+S)" Content="{StaticResource IconSave}" Command="{Binding SaveCommand}" />
        </StackPanel>
      </Grid>
    </Border>

    <Border DockPanel.Dock="Bottom" Background="{StaticResource ChromeBrush}" Padding="14,0,8,0" Height="30" BorderBrush="{StaticResource EdgeBrush}" BorderThickness="0,1,0,0">
      <DockPanel LastChildFill="False">
        <TextBlock DockPanel.Dock="Left" Style="{StaticResource StatusText}" Text="{Binding ImageSize}" />
        <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
          <Button Style="{StaticResource IconButton}" Foreground="{StaticResource MutedBrush}" Height="24" Width="28" Content="{StaticResource IconZoomOut}" ToolTip="Zoom out (Ctrl+-)" Command="{Binding ZoomOutCommand}" />
          <TextBlock Style="{StaticResource StatusText}" Width="40" TextAlignment="Center" Foreground="{StaticResource TextBrush}" Text="{Binding Zoom, Converter={StaticResource Percent}}" />
          <Button Style="{StaticResource IconButton}" Foreground="{StaticResource MutedBrush}" Height="24" Width="28" Content="{StaticResource IconZoomIn}" ToolTip="Zoom in (Ctrl++)" Command="{Binding ZoomInCommand}" />
          <Rectangle Style="{StaticResource Divider}" />
          <Button Style="{StaticResource IconButton}" Foreground="{StaticResource MutedBrush}" Height="24" Width="28" Content="{StaticResource IconFit}" ToolTip="Fit (Ctrl+0)" Command="{Binding ZoomToFitCommand}" />
          <Button Style="{StaticResource IconButton}" Foreground="{StaticResource MutedBrush}" Height="24" Width="28" Content="{StaticResource IconActualSize}" ToolTip="Actual size (Ctrl+1)" Command="{Binding ZoomToActualCommand}" />
        </StackPanel>
      </DockPanel>
    </Border>

    <Grid>
      <editor:EditorCanvas x:Name="Surface" ViewModel="{Binding}" Focusable="True" ContextMenu="{StaticResource CanvasMenu}">
        <editor:EditorCanvas.InputBindings>
          <KeyBinding Modifiers="Ctrl" Key="Z" Command="{Binding UndoCommand}" />
          <KeyBinding Modifiers="Ctrl" Key="Y" Command="{Binding RedoCommand}" />
          <KeyBinding Modifiers="Ctrl+Shift" Key="Z" Command="{Binding RedoCommand}" />
          <KeyBinding Modifiers="Ctrl" Key="C" Command="{Binding CopyCommand}" />
          <KeyBinding Modifiers="Ctrl" Key="S" Command="{Binding SaveCommand}" />
          <KeyBinding Modifiers="Ctrl+Shift" Key="S" Command="{Binding SaveAsCommand}" />
          <KeyBinding Modifiers="Ctrl" Key="A" Command="{Binding SelectAllCommand}" />
          <KeyBinding Modifiers="Ctrl" Key="D" Command="{Binding DuplicateCommand}" />
          <KeyBinding Modifiers="Ctrl" Key="OemPlus" Command="{Binding ZoomInCommand}" />
          <KeyBinding Modifiers="Ctrl" Key="Add" Command="{Binding ZoomInCommand}" />
          <KeyBinding Modifiers="Ctrl" Key="OemMinus" Command="{Binding ZoomOutCommand}" />
          <KeyBinding Modifiers="Ctrl" Key="Subtract" Command="{Binding ZoomOutCommand}" />
          <KeyBinding Modifiers="Ctrl" Key="D0" Command="{Binding ZoomToFitCommand}" />
          <KeyBinding Modifiers="Ctrl" Key="D1" Command="{Binding ZoomToActualCommand}" />
          <KeyBinding Key="Delete" Command="{Binding DeleteSelectionCommand}" />
          <KeyBinding Key="Back" Command="{Binding DeleteSelectionCommand}" />
          <KeyBinding Key="Escape" Command="{Binding DeselectCommand}" />
          <KeyBinding Key="Left" Command="{Binding NudgeCommand}" CommandParameter="left" />
          <KeyBinding Key="Right" Command="{Binding NudgeCommand}" CommandParameter="right" />
          <KeyBinding Key="Up" Command="{Binding NudgeCommand}" CommandParameter="up" />
          <KeyBinding Key="Down" Command="{Binding NudgeCommand}" CommandParameter="down" />
          <KeyBinding Key="V" Command="{Binding SelectToolCommand}" CommandParameter="{x:Static editor:EditorTool.Select}" />
          <KeyBinding Key="A" Command="{Binding SelectToolCommand}" CommandParameter="{x:Static editor:EditorTool.Arrow}" />
          <KeyBinding Key="R" Command="{Binding SelectToolCommand}" CommandParameter="{x:Static editor:EditorTool.Rectangle}" />
          <KeyBinding Key="O" Command="{Binding SelectToolCommand}" CommandParameter="{x:Static editor:EditorTool.Ellipse}" />
          <KeyBinding Key="P" Command="{Binding SelectToolCommand}" CommandParameter="{x:Static editor:EditorTool.Freehand}" />
          <KeyBinding Key="T" Command="{Binding SelectToolCommand}" CommandParameter="{x:Static editor:EditorTool.Text}" />
          <KeyBinding Key="N" Command="{Binding SelectToolCommand}" CommandParameter="{x:Static editor:EditorTool.Counter}" />
          <KeyBinding Key="H" Command="{Binding SelectToolCommand}" CommandParameter="{x:Static editor:EditorTool.Highlight}" />
          <KeyBinding Key="B" Command="{Binding SelectToolCommand}" CommandParameter="{x:Static editor:EditorTool.Blur}" />
        </editor:EditorCanvas.InputBindings>
      </editor:EditorCanvas>
      <Canvas x:Name="TextLayer">
        <TextBox x:Name="TextEntry"
                 Visibility="Collapsed"
                 MinWidth="4"
                 SelectionBrush="{StaticResource AccentBrush}"
                 SelectionOpacity="0.45"
                 Padding="0"
                 Background="Transparent"
                 BorderThickness="0"
                 FontFamily="Segoe UI Variable Text, Segoe UI"
                 FontWeight="SemiBold"
                 AcceptsReturn="False">
          <TextBox.Template>
            <ControlTemplate TargetType="TextBox">
              <ScrollViewer x:Name="PART_ContentHost" Padding="0" Margin="0" />
            </ControlTemplate>
          </TextBox.Template>
        </TextBox>
      </Canvas>
    </Grid>
  </DockPanel>
</Window>
