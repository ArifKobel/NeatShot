<Window x:Class="NeatShot.QuickAccess.QuickAccessWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:quickAccess="clr-namespace:NeatShot.QuickAccess"
        xmlns:icons="clr-namespace:NeatShot.Icons"
        mc:Ignorable="d"
        d:DataContext="{d:DesignInstance quickAccess:QuickAccessViewModel}"
        Title="NeatShot"
        SizeToContent="WidthAndHeight"
        WindowStyle="None"
        ResizeMode="NoResize"
        AllowsTransparency="True"
        Background="Transparent"
        ShowInTaskbar="False"
        ShowActivated="False"
        Topmost="True"
        FontFamily="Segoe UI Variable Text, Segoe UI">
  <Window.Resources>
    <quickAccess:NullToVisibilityConverter x:Key="NullToVisibility" />

    <Style x:Key="ActionButton" TargetType="Button">
      <Setter Property="Width" Value="32" />
      <Setter Property="Height" Value="30" />
      <Setter Property="Focusable" Value="False" />
      <Setter Property="Foreground" Value="#F2F2F5" />
      <Setter Property="Cursor" Value="Hand" />
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Button">
            <Border x:Name="Chrome" Background="Transparent" CornerRadius="6">
              <icons:Icon Data="{TemplateBinding Content}" Stroke="{TemplateBinding Foreground}" HorizontalAlignment="Center" VerticalAlignment="Center" />
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="Chrome" Property="Background" Value="#33FFFFFF" />
              </Trigger>
              <Trigger Property="IsEnabled" Value="False">
                <Setter Property="Foreground" Value="#66F2F2F5" />
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <Style x:Key="CloseButton" TargetType="Button">
      <Setter Property="Width" Value="22" />
      <Setter Property="Height" Value="22" />
      <Setter Property="Focusable" Value="False" />
      <Setter Property="Foreground" Value="#F2F2F5" />
      <Setter Property="Cursor" Value="Hand" />
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Button">
            <Grid>
              <Ellipse x:Name="Chrome" Fill="#E61E1E24" Stroke="#66FFFFFF" StrokeThickness="1" />
              <icons:Icon Data="{TemplateBinding Content}" Stroke="{TemplateBinding Foreground}" Size="11" StrokeThickness="1.5" HorizontalAlignment="Center" VerticalAlignment="Center" />
            </Grid>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="Chrome" Property="Fill" Value="#FF3A3A42" />
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>
  </Window.Resources>

  <Grid x:Name="Root" Margin="14">
    <Border x:Name="Card"
            Width="250"
            Height="160"
            Background="#1E1E24"
            CornerRadius="8"
            BorderBrush="#59FFFFFF"
            BorderThickness="1"
            Cursor="Hand">
      <Border.Effect>
        <DropShadowEffect BlurRadius="16" ShadowDepth="3" Opacity="0.5" />
      </Border.Effect>
      <Border.Clip>
        <RectangleGeometry x:Name="CardClip" RadiusX="8" RadiusY="8" />
      </Border.Clip>
      <Grid>
        <Image Source="{Binding Bitmap}" Stretch="Uniform" RenderOptions.BitmapScalingMode="HighQuality" />

        <Border x:Name="Actions"
                VerticalAlignment="Bottom"
                Background="#D91A1A20"
                Padding="4,2"
                Opacity="0"
                IsHitTestVisible="{Binding IsMouseOver, ElementName=Root}">
          <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
            <Button Style="{StaticResource ActionButton}" ToolTip="Copy" Content="{StaticResource IconCopy}" Command="{Binding CopyCommand}" />
            <Button Style="{StaticResource ActionButton}" ToolTip="Save" Content="{StaticResource IconSave}" Command="{Binding SaveCommand}" />
            <Button Style="{StaticResource ActionButton}" ToolTip="Show in folder" Content="{StaticResource IconFolderOpen}" Command="{Binding RevealInExplorerCommand}" />
            <Button Style="{StaticResource ActionButton}" ToolTip="Annotate" Content="{StaticResource IconPencil}" Command="{Binding EditCommand}" />
          </StackPanel>
        </Border>

        <Button x:Name="Dismiss"
                Style="{StaticResource CloseButton}"
                HorizontalAlignment="Right"
                VerticalAlignment="Top"
                Margin="0,6,6,0"
                Opacity="0"
                IsHitTestVisible="{Binding IsMouseOver, ElementName=Root}"
                Content="{StaticResource IconX}"
                Command="{Binding DismissCommand}" />

        <Border x:Name="ConfirmationVeil" Background="#CC1A1A20" Visibility="{Binding Confirmation, Converter={StaticResource NullToVisibility}}">
          <StackPanel x:Name="ConfirmationContent" VerticalAlignment="Center" HorizontalAlignment="Center" RenderTransformOrigin="0.5,0.5">
            <StackPanel.RenderTransform>
              <ScaleTransform />
            </StackPanel.RenderTransform>
            <icons:Icon Data="{StaticResource IconCheck}" Stroke="#F2F2F5" Size="24" StrokeThickness="2" HorizontalAlignment="Center" />
            <TextBlock Margin="0,6,0,0" FontSize="12" Foreground="#F2F2F5" HorizontalAlignment="Center" Text="{Binding Confirmation}" />
          </StackPanel>
        </Border>
      </Grid>
    </Border>

    <Grid.Triggers>
      <EventTrigger RoutedEvent="MouseEnter">
        <BeginStoryboard>
          <Storyboard>
            <DoubleAnimation Storyboard.TargetName="Actions" Storyboard.TargetProperty="Opacity" To="1" Duration="0:0:0.12" />
            <DoubleAnimation Storyboard.TargetName="Dismiss" Storyboard.TargetProperty="Opacity" To="1" Duration="0:0:0.12" />
          </Storyboard>
        </BeginStoryboard>
      </EventTrigger>
      <EventTrigger RoutedEvent="MouseLeave">
        <BeginStoryboard>
          <Storyboard>
            <DoubleAnimation Storyboard.TargetName="Actions" Storyboard.TargetProperty="Opacity" To="0" Duration="0:0:0.12" />
            <DoubleAnimation Storyboard.TargetName="Dismiss" Storyboard.TargetProperty="Opacity" To="0" Duration="0:0:0.12" />
          </Storyboard>
        </BeginStoryboard>
      </EventTrigger>
    </Grid.Triggers>
  </Grid>
</Window>
