<Window x:Class="NeatShot.Settings.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:settings="clr-namespace:NeatShot.Settings"
        mc:Ignorable="d"
        d:DataContext="{d:DesignInstance settings:SettingsViewModel}"
        Title="NeatShot Settings"
        Width="520"
        SizeToContent="Height"
        ResizeMode="NoResize"
        WindowStartupLocation="CenterScreen">
  <Window.Resources>
    <Style x:Key="SectionHeader" TargetType="TextBlock">
      <Setter Property="FontSize" Value="13" />
      <Setter Property="FontWeight" Value="SemiBold" />
      <Setter Property="Margin" Value="0,16,0,8" />
      <Setter Property="Opacity" Value="0.8" />
    </Style>
    <Style x:Key="Label" TargetType="TextBlock">
      <Setter Property="VerticalAlignment" Value="Center" />
      <Setter Property="Margin" Value="0,0,12,0" />
    </Style>
    <Style TargetType="TextBox" BasedOn="{StaticResource {x:Type TextBox}}">
      <Setter Property="Margin" Value="0,4" />
    </Style>
    <Style TargetType="CheckBox" BasedOn="{StaticResource {x:Type CheckBox}}">
      <Setter Property="Margin" Value="0,4" />
    </Style>
  </Window.Resources>

  <StackPanel Margin="24,12,24,20">
    <TextBlock Style="{StaticResource SectionHeader}" Text="Files" />
    <Grid>
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="140" />
        <ColumnDefinition Width="*" />
        <ColumnDefinition Width="Auto" />
      </Grid.ColumnDefinitions>
      <Grid.RowDefinitions>
        <RowDefinition />
        <RowDefinition />
        <RowDefinition />
        <RowDefinition />
      </Grid.RowDefinitions>

      <TextBlock Grid.Row="0" Grid.Column="0" Style="{StaticResource Label}" Text="Save to" />
      <TextBox Grid.Row="0" Grid.Column="1" Text="{Binding SaveDirectory, UpdateSourceTrigger=PropertyChanged}" />
      <Button Grid.Row="0" Grid.Column="2" Margin="8,0,0,0" Padding="12,4" Content="Browse…" Command="{Binding BrowseDirectoryCommand}" />

      <TextBlock Grid.Row="1" Grid.Column="0" Style="{StaticResource Label}" Text="File name" />
      <TextBox Grid.Row="1" Grid.Column="1" Grid.ColumnSpan="2" Text="{Binding FileNamePattern, UpdateSourceTrigger=PropertyChanged}" />

      <TextBlock Grid.Row="2" Grid.Column="1" Grid.ColumnSpan="2" Margin="0,0,0,6" Opacity="0.6" FontSize="12" TextWrapping="Wrap">
        <Run Text="Tokens: {date} {time} {year} {month} {day} {hour} {minute} {second}. Preview: " /><Run Text="{Binding FileNamePreview, Mode=OneWay}" />
      </TextBlock>

      <TextBlock Grid.Row="3" Grid.Column="0" Style="{StaticResource Label}" Text="Format" />
      <ComboBox Grid.Row="3" Grid.Column="1" Width="120" HorizontalAlignment="Left" Margin="0,4"
                ItemsSource="{Binding ImageFormats}" SelectedItem="{Binding ImageFormat}" />
    </Grid>

    <TextBlock Style="{StaticResource SectionHeader}" Text="After capture" />
    <CheckBox Content="Copy image to clipboard" IsChecked="{Binding CopyToClipboard}" />
    <CheckBox Content="Save image to disk automatically" IsChecked="{Binding SaveToDisk}" />
    <StackPanel Orientation="Horizontal" Margin="0,4">
      <TextBlock Style="{StaticResource Label}" Text="Hide quick access after" />
      <TextBox Width="48" Text="{Binding QuickAccessSeconds, UpdateSourceTrigger=PropertyChanged}" TextAlignment="Center" />
      <TextBlock Style="{StaticResource Label}" Margin="8,0,0,0" Text="seconds" />
    </StackPanel>

    <TextBlock Style="{StaticResource SectionHeader}" Text="Shortcuts" />
    <ItemsControl ItemsSource="{Binding Hotkeys}">
      <ItemsControl.ItemTemplate>
        <DataTemplate>
          <Grid>
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="140" />
              <ColumnDefinition Width="200" />
            </Grid.ColumnDefinitions>
            <TextBlock Style="{StaticResource Label}" Text="{Binding Label}" />
            <settings:HotkeyBox Grid.Column="1" Margin="0,4" Hotkey="{Binding Hotkey}" />
          </Grid>
        </DataTemplate>
      </ItemsControl.ItemTemplate>
    </ItemsControl>

    <TextBlock Style="{StaticResource SectionHeader}" Text="System" />
    <CheckBox Content="Launch NeatShot when I sign in" IsChecked="{Binding LaunchAtStartup}" />

    <TextBlock Margin="0,12,0,0" Foreground="#E5484D" TextWrapping="Wrap" Text="{Binding Error}" />

    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,16,0,0">
      <Button Padding="16,6" Margin="0,0,8,0" Content="Cancel" IsCancel="True" Command="{Binding CancelCommand}" />
      <Button Padding="16,6" Content="Save" IsDefault="True" Command="{Binding SaveCommand}" />
    </StackPanel>
  </StackPanel>
</Window>
