<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <RootNamespace>NeatShot</RootNamespace>
    <AssemblyName>NeatShot</AssemblyName>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <NoWarn>$(NoWarn);WPF0001</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\NeatShot.Core\NeatShot.Core.csproj" />
    <ProjectReference Include="..\NeatShot.Platform\NeatShot.Platform.csproj" />
  </ItemGroup>

</Project>
